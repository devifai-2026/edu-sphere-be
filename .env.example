# Copy to .env and fill in.
# Local Docker:  mongodb://127.0.0.1:27017/edusphere
# MongoDB Atlas: mongodb+srv://<user>:<pass>@<cluster>/edusphere?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/edusphere
PORT=4000
JWT_SECRET=change-me-in-production
# Seeded admin login (created by `npm run seed`)
ADMIN_EMAIL=admin@edusphere.app
ADMIN_PASSWORD=admin123

# --- Image/PDF uploads (Cloudinary primary, ImageBB fallback) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
IMGBB_API_KEY=

# --- Google Cloud: GCS video bucket + Vertex AI ---
# One service account (Storage Object Admin + Vertex AI User). Provide its JSON key
# base64-encoded (single line):  base64 -i sa.json | tr -d '\n'
# Or mount the file and set GOOGLE_APPLICATION_CREDENTIALS instead.
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
GCS_BUCKET=
GCP_SA_JSON_BASE64=
